{
  "cli": {
    "version": ">= 16.20.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "development-halijah": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "COMPANY_ID": "halijah"
      }
    },
    "development-manasiktech": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "COMPANY_ID": "manasiktech"
      }
    },
    "production-halijah": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "COMPANY_ID": "halijah"
      }
    },
    "production-manasiktech": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "COMPANY_ID": "manasiktech"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "companyName": "Halijah Travels Pte Ltd"
      }
    }
  }
}
